# Local configuration template. Copy to .env and fill in this installation's values.
NODE_ENV=production
HOST=0.0.0.0
PORT=3091
API_BASE_PATH=/api

# Central SQL Server and tenant databases; runtime login, not the DDL installer account.
BMS_SQL_SERVER=sql-server.example.invalid
BMS_SQL_PORT=1433
BMS_SQL_INSTANCE_NAME=
BMS_SQL_DATABASE=BMS
BMS_SQL_USER=
BMS_SQL_PASSWORD=
BMS_SQL_ENCRYPT=true
BMS_SQL_TRUST_SERVER_CERT=false
BMS_SQL_APP_SCHEMA=BMSApp

# FX identity/mandant directory. Set the actual databases used by this installation.
FX_SQL_SERVER=fx-sql-server.example.invalid
FX_SQL_PORT=1433
FX_SQL_INSTANCE_NAME=
FX_SQL_USER_NAME=
FX_SQL_USER_PASSWORD=
FX_SQL_DATABASE_MANDANT_MANAGER=
FX_SQL_DATABASE_ML_PLASTICS=
FX_SQL_ENCRYPT=true
FX_SQL_TRUST_SERVER_CERTIFICATE=false

# Reverse proxy supplies the authenticated x-ms-client-samaccountname header.
# Configure trusted authentication at the proxy; there is no local identity bypass.
CORS_ENABLED=false

# Optional document share and push keys.
BMS_BASE_FILE_PATH_SERVER=
PUSH_VAPID_SUBJECT=mailto:admin@example.invalid
PUSH_VAPID_PUBLIC_KEY=
PUSH_VAPID_PRIVATE_KEY=

# Enable write/notification integrations only after configuring the target services.
BMS_CUSTOMER_API_ENABLED=false
BMS_CUSTOMER_API_WRITE_ENABLED=false
BMS_CUSTOMER_API_BASE_ADDRESS=
BMS_CUSTOMER_API_KEY=
FILEHOUSE_MAIL_SERVICE_ENABLED=false
FILEHOUSE_MAIL_SERVICE_BASE_ADDRESS=
FILEHOUSE_MAIL_SERVICE_API_KEY=
BMS_ORDER_MAIL_ENABLED=false
BMS_ORDER_MAIL_EWS_FALLBACK=false
BMS_PURCHASE_ORDER_MAIL_ENABLED=false
BMS_CREDIT_LIMIT_MAIL_ENABLED=false
BMS_VL_COMPLETION_MAIL_ENABLED=false
BMS_DAILY_VL_MAIL_ENABLED=false
BMS_UNFINALIZED_ORDER_REMINDER_INTERVAL_MINUTES=

# Optional EWS fallback when explicitly enabled above.
EWS_USERNAME=
EWS_PASSWORD=
EWS_URL_EXTERN=
# Internal offer previews after BMS status 2 and PDF. Set either flag to false to opt out.
BMS_OPTION_OFFER_MAIL_ENABLED=true
BMS_STOCK_OFFER_MAIL_ENABLED=true
