<?xml version="1.0" encoding="UTF-8"?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema"
           xmlns:o="urn:filehouse:bms:customer-offer:1"
           targetNamespace="urn:filehouse:bms:customer-offer:1"
           elementFormDefault="qualified">
  <xs:complexType name="QuantityInKg">
    <xs:simpleContent>
      <xs:extension base="xs:decimal">
        <xs:attribute name="unit" type="xs:string" use="required" fixed="KGM"/>
      </xs:extension>
    </xs:simpleContent>
  </xs:complexType>
  <xs:complexType name="PriceInEur">
    <xs:simpleContent>
      <xs:extension base="xs:decimal">
        <xs:attribute name="currency" type="xs:string" use="required" fixed="EUR"/>
      </xs:extension>
    </xs:simpleContent>
  </xs:complexType>
  <xs:element name="Offer">
    <xs:complexType>
      <xs:sequence>
        <xs:element name="OfferNumber" type="xs:string"/>
        <xs:element name="CustomerNumber" type="xs:string"/>
        <xs:element name="NonBinding" type="xs:boolean" fixed="true"/>
        <xs:element name="ValidUntil" type="xs:date" minOccurs="0"/>
        <xs:element name="Position">
          <xs:complexType>
            <xs:sequence>
              <xs:element name="ArticleNumber" type="xs:string"/>
              <xs:element name="ArticleName" type="xs:string"/>
              <xs:element name="Batch" type="xs:string" minOccurs="0"/>
              <xs:element name="Quantity" type="o:QuantityInKg"/>
              <xs:element name="PricePerTonne" type="o:PriceInEur"/>
              <xs:element name="AvailableBatchQuantity" type="o:QuantityInKg" minOccurs="0"/>
            </xs:sequence>
          </xs:complexType>
        </xs:element>
        <xs:element name="Delivery">
          <xs:complexType>
            <xs:sequence>
              <xs:element name="Incoterm">
                <xs:simpleType><xs:restriction base="xs:string"><xs:pattern value="[A-Z]{3}"/></xs:restriction></xs:simpleType>
              </xs:element>
              <xs:element name="PickupLocation" type="xs:string" minOccurs="0"/>
            </xs:sequence>
          </xs:complexType>
        </xs:element>
      </xs:sequence>
      <xs:attribute name="version" type="xs:string" use="required" fixed="1.0"/>
    </xs:complexType>
  </xs:element>
</xs:schema>
